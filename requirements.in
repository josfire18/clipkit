# compiled from this file and pins every package (direct and transitive) to an exact
# version, so audits and Dependabot see real versions. After editing, regenerate with:
#   pip install pip-tools
#   pip-compile --strip-extras --no-emit-index-url --output-file=requirements.txt requirements.in
